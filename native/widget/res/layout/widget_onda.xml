<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_fondo">

    <ImageView
        android:id="@+id/w_arte"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_w_nota"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Onda" />

        <TextView
            android:id="@+id/w_artista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:text="Toca para abrir" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_w_prev"
        android:contentDescription="Anterior" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_boton_play"
        android:src="@drawable/ic_w_play"
        android:contentDescription="Reproducir o pausar" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_w_next"
        android:contentDescription="Siguiente" />
</LinearLayout>
